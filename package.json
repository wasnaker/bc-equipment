{
  "name": "@wasnaker/module-equipment",
  "version": "0.6.0",
  "description": "Wasnaker equipment management module (NestJS API and Next.js web)",
  "license": "GPL-2.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "index.ts",
    "api/package.json",
    "api/dist",
    "web/src/modules/equipment",
    "web/src/services/i18n/locales"
  ],
  "exports": {
    ".": "./index.ts",
    "./web": "./web/src/modules/equipment/index.ts",
    "./manifest": "./web/src/modules/equipment/module.manifest.ts",
    "./api": {
      "types": "./api/dist/index.d.ts",
      "require": "./api/dist/index.js",
      "default": "./api/dist/index.js"
    },
    "./api/manifest": {
      "types": "./api/dist/equipment/equipment.manifest.d.ts",
      "require": "./api/dist/equipment/equipment.manifest.js",
      "default": "./api/dist/equipment/equipment.manifest.js"
    },
    "./api/migrations": {
      "types": "./api/dist/equipment/database/migrations/index.d.ts",
      "require": "./api/dist/equipment/database/migrations/index.js",
      "default": "./api/dist/equipment/database/migrations/index.js"
    },
    "./locales/en": "./web/src/services/i18n/locales/en/module-equipment.json",
    "./locales/id": "./web/src/services/i18n/locales/id/module-equipment.json",
    "./locales/ja": "./web/src/services/i18n/locales/ja/module-equipment.json",
    "./locales/ko": "./web/src/services/i18n/locales/ko/module-equipment.json",
    "./locales/zh": "./web/src/services/i18n/locales/zh/module-equipment.json",
    "./api/entities": {
      "types": "./api/dist/equipment/equipment.entities.d.ts",
      "require": "./api/dist/equipment/equipment.entities.js",
      "default": "./api/dist/equipment/equipment.entities.js"
    },
    "./api/definition": {
      "types": "./api/dist/equipment/equipment.definition.d.ts",
      "require": "./api/dist/equipment/equipment.definition.js",
      "default": "./api/dist/equipment/equipment.definition.js"
    },
    "./api/seeds": {
      "types": "./api/dist/equipment/equipment.seeds.d.ts",
      "require": "./api/dist/equipment/equipment.seeds.js",
      "default": "./api/dist/equipment/equipment.seeds.js"
    }
  },
  "scripts": {
    "build:api": "tsc -p api/tsconfig.build.json",
    "prepare": "npm run build:api",
    "verify:api-package": "node scripts/verify-api-package.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0 || ^0.15.0",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@tanstack/react-query": "^5.95.2",
    "lucide-react": "^1.18.0",
    "next": "^16.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^16.6.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/passport": "11.0.5",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/typeorm": "11.0.1",
    "@types/node": "25.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "passport": "0.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/passport": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "passport": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-select": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "yup": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "index.ts"
      ],
      "api": [
        "api/dist/index.d.ts"
      ],
      "api/manifest": [
        "api/dist/equipment/equipment.manifest.d.ts"
      ],
      "api/migrations": [
        "api/dist/equipment/database/migrations/index.d.ts"
      ],
      "manifest": [
        "web/src/modules/equipment/module.manifest.ts"
      ],
      "api/entities": [
        "api/dist/equipment/equipment.entities.d.ts"
      ],
      "api/definition": [
        "api/dist/equipment/equipment.definition.d.ts"
      ],
      "api/seeds": [
        "api/dist/equipment/equipment.seeds.d.ts"
      ],
      "web": [
        "web/src/modules/equipment/index.ts"
      ]
  }
}
